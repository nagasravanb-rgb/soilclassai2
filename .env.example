# SoilClass AI — server-side configuration. Copy to .env.local and fill in.
# Never commit real secrets. These values are read only on the server.

# AI provider: "gemini" (real image analysis) or "mock" (demo fixtures for tests; NOT real analysis).
AI_PROVIDER=gemini

# API key for the selected provider. GEMINI_API_KEY is accepted as a fallback name.
AI_API_KEY=replace-with-your-api-key

# Optional: vision-capable model ID available to your key. Defaults to gemini-3.8-flash.
# AI_MODEL=gemini-3.8-flash

# Optional: provider request timeout in milliseconds (1000–120000). Default 25000.
# AI_TIMEOUT_MS=25000

# Optional: maximum upload size in MB (1–20). Default 4 (fits Vercel's 4.5 MB request limit).
# Larger photos are downscaled in the browser before upload.
# MAX_UPLOAD_MB=4

# Optional: history storage. "browser" (default, localStorage on each device) or "file"
# (JSON file on the server; needs a persistent writable disk — not suitable for Vercel).
# HISTORY_STORAGE=browser
# HISTORY_FILE_PATH=.data/history.json

# Optional: base URL of the API if the frontend is served separately. Leave empty for same origin.
# NEXT_PUBLIC_API_BASE_URL=

# Optional: artificial delay for the mock provider, in milliseconds.
# MOCK_DELAY_MS=0
